void buzz_set() {
		alarm_data1=hex_data[12];
		alarm_data2=hex_data[11];
		alarm_count = 0;
		alarm_number1=alarm_data1;
		for(alarm_number_1i=0;alarm_number1!=0;alarm_number_1i++)	{		//�˶� ���� Ȯ��
				alarm_number1&=(alarm_number1-1);
		}
		alarm_number2=alarm_data2&0x05E7;															//ON OFF ����ġ üũ ��
		for(alarm_number_2i=0;alarm_number2!=0;alarm_number_2i++)	{		//�˶� ���� Ȯ��
				alarm_number2&=(alarm_number2-1);
		}
		alarm_number=alarm_number1+alarm_number2;
		alarm_number_i=alarm_number_1i+alarm_number_2i;
			
}

void alarm_set() {
		myGLCD.setFont(Retro);
		myGLCD.setBackColor(255, 255, 255);
		myGLCD.setColor(255, 0, 0);
		alarm_data1=hex_data[12];
		alarm_data2=hex_data[11];
//	alarm_data1=abcd;
		alarm_count = 0;
		k=0;
		y1=40;
		alarm_number1=alarm_data1;
		for(alarm_number_1i=0;alarm_number1!=0;alarm_number_1i++)	{		//�˶� ���� Ȯ��
				alarm_number1&=(alarm_number1-1);
		}
//	for(i=0;i<alarm_number_i;i++)
		for(i=0;i<16;i++)	{	
				if (y1>193) break;
				alarm_check=alarm_data1&0x0001;
				if(alarm_check==1) {
      			if (k==0) { 
      					if (page_num == alarm1_i)	{
      							myGLCD.print("Input current limit fault", 20,y1);
      							y1=y1+22;
      					}
      					else if ((page_num == alarm2_i)||(page_num == alarm3_i)) alarm_count++;
      			}	
      			if (k==1) {
      					if (page_num == alarm1_i)	{
      							myGLCD.print("Vdc_link OV limit fault", 20,y1);
      							y1=y1+22;
      					}
      					else if ((page_num == alarm2_i)||(page_num == alarm3_i)) alarm_count++;
      			}
      			if (k==2) {
      					if (page_num == alarm1_i)	{
      							myGLCD.print("Vdc_link UV limit fault", 20,y1);
      							y1=y1+22;
      					}
      					else if ((page_num == alarm2_i)||(page_num == alarm3_i)) alarm_count++;
      			}
      			if (k==3) {
      					if (page_num == alarm1_i)	{
      							myGLCD.print("Input under voltage fault", 20,y1);
      							y1=y1+22;
      					}
      					else if ((page_num == alarm2_i)||(page_num == alarm3_i)) alarm_count++;
      			}
      			if (k==4) {
      					if (page_num == alarm1_i)	{
      							myGLCD.print("Input over voltage fault", 20,y1);
      							y1=y1+22;
      					}
      					else if ((page_num == alarm2_i)||(page_num == alarm3_i)) alarm_count++;
      			}
      			if (k==5) {
      					if (page_num == alarm1_i)	{
      							myGLCD.print("Input frequency fault", 20,y1);
      							y1=y1+22;
      					}
      					else if ((page_num == alarm2_i)||(page_num == alarm3_i)) alarm_count++;
      			}
      			if (k==6) {
      					if (page_num == alarm1_i)	{
      							myGLCD.print("Inverter frequency fault", 20,y1);
      							y1=y1+22;
      					}
      					else if ((page_num == alarm2_i)||(page_num == alarm3_i)) alarm_count++;
      			}
      			if (k==7) {
      					if (page_num == alarm1_i) {
      							myGLCD.print("Utility line failure", 20,y1);
      							y1=y1+22;
      					}
      					else if (page_num == alarm2_i) {	 
      							alarm_count++;
      							if ((alarm_count >7)&&(alarm_count <15)) {
      									myGLCD.print("Utility line failure", 20,y1);
      									y1=y1+22;
      							}
      					}
      					else if (page_num == alarm3_i) alarm_count++;
      			}
      			if (k==8) {
      					if (page_num == alarm1_i)	{
      							myGLCD.print("Battery current limit fault", 20,y1);
      							y1=y1+22;
      					}
      					else if (page_num == alarm2_i) {	 
      							alarm_count++;
      							if ((alarm_count >7)&&(alarm_count <15)) {
      									myGLCD.print("Battery current limit fault", 20,y1);
