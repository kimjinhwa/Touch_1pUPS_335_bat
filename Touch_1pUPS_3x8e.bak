								if(see_eeprom == 0)myGLCD.print("Input current limit fault", 20,y1);
	   	  				else if(see_eeprom == 1)myGLCD.print("Vdc_link OV limit fault", 20,y1);
								else if(see_eeprom == 2)myGLCD.print("Vdc_link UV limit fault", 20,y1);
	   	 					else if(see_eeprom == 3)myGLCD.print("Input under voltage fault", 20,y1);
	   	 					else if(see_eeprom == 4)myGLCD.print("Input over voltage fault", 20,y1);
	   					 	else if(see_eeprom == 5)myGLCD.print("Input frequency fault", 20,y1);
	   	 					else if(see_eeprom == 6)myGLCD.print("Inverter frequency fault", 20,y1);
	   					 	else if(see_eeprom == 7)myGLCD.print("Utility line failure", 20,y1);
	   					 	else if(see_eeprom == 8)myGLCD.print("Battery current limit fault", 20,y1);
	   					 	else if(see_eeprom == 9)myGLCD.print("Battery OV limit fault", 20,y1);
	   					 	else if(see_eeprom == 10)myGLCD.print("Battery UV limit fault", 20,y1);
	   					 	else if(see_eeprom == 11)myGLCD.print("Inverter output voltage fault", 20,y1);
	   					 	else if(see_eeprom == 12)myGLCD.print("Inverter OC overtime fault", 20,y1);	
	   					 	else if(see_eeprom == 13)myGLCD.print("Input OC", 20,y1);					
	   					 	else if(see_eeprom == 14)myGLCD.print("Inverter OC", 20,y1);
	   					 	else if(see_eeprom == 15)myGLCD.print("Vdc_link OV", 20,y1);
	   					 	else if(see_eeprom == 18)myGLCD.print("Converter GDU", 20,y1);
	   					 	else if(see_eeprom == 19)myGLCD.print("Inverter GDU", 20,y1);
	   					 	else if(see_eeprom == 20)myGLCD.print("DC/DC GDU", 20,y1);
	   					 	else if(see_eeprom == 21)myGLCD.print("Common GDU", 20,y1);
	   					 	else if(see_eeprom == 23)myGLCD.print("Battery FUSE", 20,y1);
	   					 	else if(see_eeprom == 24)myGLCD.print("Converter ON State", 20,y1);
	   					 	else if(see_eeprom == 25)myGLCD.print("DC/DC CONV ON State", 20,y1);
	   					 	else if(see_eeprom == 26)myGLCD.print("Inverter ON State", 20,y1);
	   					 	else if(see_eeprom == 27)myGLCD.print("Inverter Mode Start", 20,y1);	
	   					 	else if(see_eeprom == 28)myGLCD.print("Converter OFF State", 20,y1);
	   					 	else if(see_eeprom == 29)myGLCD.print("DC/DC CONV OFF State", 20,y1);
	   					 	else if(see_eeprom == 30)myGLCD.print("Inverter OFF State", 20,y1);
	   					 	else if(see_eeprom == 31)myGLCD.print("Bypass Mode Start", 20,y1);							
								z=z-7;
								if(z==0)break;
	//						y1+=5
						}
				}
		}
//	y1=18;
		page_num = history_i;
}
void eeprom_write()
{
		eeprom_address_h=EEPROM.read(4094);
		eeprom_address_l=EEPROM.read(4095);
		eeprom_address=(eeprom_address_l&0x00ff)|((eeprom_address_h<<8)&0xff00);
		EEPROM.write(eeprom_address,(rtc_year-2000));
		EEPROM.write(eeprom_address+1,rtc_month);
		EEPROM.write(eeprom_address+2,rtc_day);
		EEPROM.write(eeprom_address+3,rtc_hour);
		EEPROM.write(eeprom_address+4,rtc_minute);
		EEPROM.write(eeprom_address+5,rtc_second);
		EEPROM.write(eeprom_address+6,eeprom_data);
		eeprom_address+=7;
		
		
		if(eeprom_address>3499) {						//||(eeprom_address==(EEPROM.length()-1))||(eeprom_address==EEPROM.length()-2)
				eeprom_address=0;
		}
				eeprom_address_h = (eeprom_address >>8) & 0xff;
	  		eeprom_address_l = (eeprom_address & 0xff);
				EEPROM.write(4094,eeprom_address_h);
				EEPROM.write(4095,eeprom_address_l);
	//	eeprom_address+=3;
}	
void eeprom_set() {
		if(hex_data[12]!=ups_hw_state2)	{
  		
//  	ups_hw_state1^=hex_data[5];
//		hex_hw2=0x0F;
				hex_hw2=ups_hw_state2;
  			ups_hw_state2^=hex_data[12];  	
  			for(int routine_check2=0;routine_check2<13;routine_check2++) {
  					ups_hw_check2=ups_hw_state2&0x0001;
  					hex_hw2_h=hex_hw2&0x0001;
						if((ups_hw_check2==1)&&(hex_hw2_h==0)) {
								eeprom_data=routine_check2;
								eeprom_write();
								buzzer_switch=1;
						}
						ups_hw_state2=ups_hw_state2>>1;
						hex_hw2=hex_hw2>>1;
  			}
  			ups_hw_state2=hex_data[12];
  	}
		if(hex_data[11]!=ups_hw_state1) {
			 	hex_hw1=ups_hw_state1;
			 	ups_hw_state1^=hex_data[11];
			 	for(int routine_check1=0;routine_check1<15;routine_check1++) {
			 			ups_hw_check1=ups_hw_state1&0x0001;
			 			hex_hw1_h=hex_hw1&0x0001;
						if((ups_hw_check1==1)&&(hex_hw1_h==0)) {
								eeprom_data = routine_check1+13;
								eeprom_write();
								if (routine_check1<11) buzzer_switch=1;
						}
						if((ups_hw_check1==1)&&(hex_hw1_h==1)) {
								eeprom_data = routine_check1+17;
								eeprom_write();
						}	
						ups_hw_state1=ups_hw_state1>>1;
						hex_hw1=hex_hw1>>1;
			 	}
			 	ups_hw_state1=hex_data[11];
		}   
}
void serial_rx()
{
//	Serial.println("start");
		if(Serial1.available())	{
				serial_length=Serial1.available();
				Serial.println(serial_length);
				int i,j;
				int rx_num, addr_num; 	
    		for(i=0;i<serial_length;i++) {
      			rx[i] = Serial1.read();
//      Serial.println(rx[i],HEX);
    		}
    		while(Serial1.available()>0) {
  					Serial1.read();
				}	
//		Serial.println(Serial1.available());
    		if(rx[1]==0x04) {
    				if(serial_length ==11) {
    						rx_num=3;
								addr_num=10;							
						}		
						else {		
								if(page_num==meter_i) {											
										rx_num=11;
										addr_num=30;
								}
								else if(page_num==sett_i) {											
										rx_num=8;
										addr_num=50;
								}
								else if(page_num==intro_i) {											
										rx_num=4;
										addr_num=0;
								}
								else if((page_num==secret1_i)||(page_num==secret2_i)) {											
										rx_num=19;
										addr_num=60;
								}
								else if(page_num==offset_i) {											
										rx_num=9;
										addr_num=90;
								}
								else if(page_num==control_i) {											
										rx_num=6;
										addr_num=15;
								}																	
						}
						crc_rx_data = MODBUS_CRC(rx, (rx_num*2)+3);
  					crc_rx_h = (crc_rx_data >>8) & 0xff;
  					crc_rx_l = (crc_rx_data & 0xff);
	      		if ((rx[(rx_num*2)+3]==crc_rx_h)&&(rx[(rx_num*2)+4]==crc_rx_l))	{    		
    						for(j=0;j<rx_num;j++) {
  	    						hex_data[j+addr_num] = ((short)(rx[j*2+4]&0x00ff) | (((short)rx[j*2+3]<<8)&0xff00));
  	    						Serial.print(hex_data[j+addr_num]);
  	    						Serial.print(" ");  	    			
	      				} 	
						}	
	      		Serial.println();	
	      		eeprom_set();  
    		}
  			
    		if(rx[1]==0x10) {
						for(j=0;j<8;j++) {
      					Serial.print(rx[j],HEX);
      					Serial.print(" ");
    				}
    				Serial.println(Scic_Tx_Frame_Buf[8]);
    				Serial.println();
    		}
  			i=0;
  			j=0; 		
		}
}	

