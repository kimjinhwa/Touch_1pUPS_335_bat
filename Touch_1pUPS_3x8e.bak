		if(z!=0) {
				for(int history_line=0;history_line<4;history_line++) {
	//		Serial.println(z);
						if(z<(eeprom_address+1)) {			//(EEPROM.read(z)<100)
								y1+=22;
								myGLCD.setColor(50, 50, 50);
								see_eeprom=EEPROM.read(z-7);
								see_eeprom+=2000;
