         				}
         				if ((x>=200) && (x<=310) && (y>=185) && (y<=235))	{	//battery voltage (20, 30, 150, 87);
         					waitForIt(200, 185, 310, 235);
         					page_num=sett;
         				}
//         		}
     				break;						
 		}
 		leesh =0;
 	}
 	
 	else leesh++;
	if(leesh >40) {
		leesh =0;
		myTouch.InitTouch();
//		pinMode(41, OUTPUT);	
//		digitalWrite(41, LOW);
//		delay(10);
//		digitalWrite(41, LOW);
			myTouch.InitTouch();	
//		myTouch.touch_WriteData(0x90);
	}
}
