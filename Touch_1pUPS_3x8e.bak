void interrupt() {
		
	  timer300ms++;
  	timer60ms++;
  	timer1500ms++;
  	
  	if (buzzer_switch==1) {	
				if(timer1500ms == 10) {
    				buzz = 1;
    				digitalWrite(buzzer, buzz);
  			}
  			if(timer1500ms == 400) {
    				buzz = 0;
    				digitalWrite(buzzer, buzz);
  			}
  	}
  	else { 
  			buzz = 0;
  			digitalWrite(buzzer, buzz);
  	}
  	
  	
  	if(timer1500ms > 1499) {
    		timer1500ms=0;
  	}
  	if(timer60ms > 49) {
  			timer60ms=0;
  			touch_check=1;    		 		
  	}
//  	if(timer300ms > 299) {
// 			timer300ms=0; 
//  			timer_check=1;
/*
  			tx_toggle=tx_toggle^1;
  			if(tx_toggle==0) {
  					alarm_tx();
  			}
  			else if(tx_toggle==1) {
  					data_tx();
    		}		
*/    		
//  	}
}

